# Maintainer: Pavel <254324686+pavel-bex@users.noreply.github.com>
pkgname=rezoom
pkgver=1.1.0
pkgrel=1
pkgdesc="Chat-list organizer for AI coding sessions (Claude Code, Codex) and terminals"
arch=(x86_64)
url="https://github.com/BEX-Robotics/rezoom"
license=(MIT)
# Arch ships konsolepart inside the konsole package
depends=(qt6-base kparts kcoreaddons konsole)
makedepends=(cmake ninja extra-cmake-modules git)
optdepends=('tmux: persistent plain terminals and tmux-session adoption'
            'reptyr: move running sessions in and out of the app live'
            'jq: freeze detection (Claude Code Notification hook)')
source=("git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
    cmake -B build -S "$pkgname" -G Ninja -DCMAKE_BUILD_TYPE=None
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
